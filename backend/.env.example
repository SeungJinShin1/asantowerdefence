# 복사해서 backend/.env 로 사용 (절대 커밋 금지)
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
ADMIN_TOKEN=change-me-admin-token

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 서비스 계정 JSON을 base64 한 줄로: base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=
FIRESTORE_COLLECTION_PREFIX=defence_

VARIANTS_PER_QUESTION=2
BOOTH_MODE=true
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
SENTRY_DSN=
