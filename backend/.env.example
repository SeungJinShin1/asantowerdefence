# 복사해서 backend/.env 로 사용 (절대 커밋 금지)
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
# 배포된 프론트 주소(기본값 Vercel). CORS 에 자동 포함 — 보통 바꿀 필요 없음
FRONTEND_URL=https://asantowerdefence.vercel.app
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
ADMIN_TOKEN=change-me-admin-token

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash   # 생략 가능(코드 기본값 동일)

# 서비스 계정: JSON 파일 내용을 그대로 붙여넣어도 되고(권장), base64 한 줄도 된다
FIREBASE_SERVICE_ACCOUNT_B64=
# 또는 JSON 파일 경로(둘 중 하나만). Render 는 Secret Files → /etc/secrets/<파일명>
FIREBASE_SERVICE_ACCOUNT_FILE=
FIRESTORE_COLLECTION_PREFIX=defence_

VARIANTS_PER_QUESTION=2
BOOTH_MODE=true
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
SENTRY_DSN=
