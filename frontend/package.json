{
  "name": "defence-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "아산 향토사 AI 챗봇 학습 + 타워디펜스 — 프론트엔드",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
